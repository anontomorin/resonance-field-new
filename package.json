{
  "name": "resonance-field",
  "private": true,
  "version": "1.0.0",
  "description": "《共振场：回声海图》—— 基于网格 BFS 声波传播的 2D 空间感知益智游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "esbuild scripts/validateLevels.ts --bundle --platform=node --format=esm --outfile=.tmp/validateLevels.mjs --log-level=warning && node .tmp/validateLevels.mjs",
    "emit-keys": "esbuild scripts/emitKeys.ts --bundle --platform=node --format=esm --outfile=.tmp/emitKeys.mjs --log-level=warning && node .tmp/emitKeys.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.64.5",
    "@esbuild/linux-x64": "^0.28.2",
    "@rollup/rollup-linux-x64-gnu": "^4.64.5"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "esbuild": "^0.21.5",
    "nanoid": "^3.3.20",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.29",
    "rollup": "^4.64.5",
    "source-map-js": "^1.2.2",
    "undici-types": "^8.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anontomorin/resonance-field-new.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anontomorin/resonance-field-new/issues"
  },
  "homepage": "https://github.com/anontomorin/resonance-field-new#readme"
}
